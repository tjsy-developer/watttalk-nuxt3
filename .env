NUXT_PUBLIC_MANAGER_DOMAIN=http://localhost:8205

# 매니저 baseurl
NUXT_PUBLIC_MANAGER_BASE_URL=/wattmanager2

# 업체별 개별 설정
NUXT_PUBLIC_MAIN_LOGO_PATH=/logos/hdcar_logo.png
NUXT_PUBLIC_FAVICON_PATH=/favicons/hdcar.png
NUXT_PUBLIC_HEAD_TITLE=스마트글래스 AR 솔루션 - 와트톡

# 파일 수신 시 저장 경로
NUXT_PUBLIC_SAVE_PHOTO_PATH=/storage/watttalk/photos/

# socket.io 설정
NUXT_PUBLIC_SIGNALLING_URL=https://hdcardev.watttalk.kr:8201
NUXT_PUBLIC_TRANSFER_URL=https://hdcardev.watttalk.kr:8202

# janus server 설정
NUXT_PUBLIC_JANUS_SERVER_IP=wss://hdcardev.watttalk.kr:8989

# iceSever 계정 설정
ICE_SERVER_URL=turn:hdcardev.watttalk.kr:3478
ICE_SERVER_USER="dykim"
ICE_SERVER_CREDENTIAL="superman123"

